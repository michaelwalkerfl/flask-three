# Copy to config.env and adjust. config.env is git-ignored.

# App
APP_ENV=development
APP_NAME=Flask3
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Database (Docker Compose service "db")
DB_USER=flaskthreeuser
DB_PASS=flaskthreepassword
DB_NAME=flaskthree
DEVELOPMENT_DATABASE=postgresql://flaskthreeuser:flaskthreepassword@db:5432/flaskthree
# PRODUCTION_DATABASE=postgresql://user:pass@host:5432/dbname

# Redis (sessions and background jobs)
SESSION_REDIS=redis://redis:6379/0

# Mail
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# Admin account created by `flask create-admin`; also receives contact form messages
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
