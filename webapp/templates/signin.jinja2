{% extends "base.jinja2" %}
{% from "_macros.jinja2" import field %}

{% block title %}Sign in | {{ config.APP_NAME }}{% endblock %}

{% block content %}
<section class="auth">
  <div class="auth-card card">
    <div class="auth-head">
      <h1>Welcome back</h1>
      <p class="muted">Sign in to your account to continue.</p>
    </div>
    <form method="POST" action="{{ url_for('dashboard.signin', next=request.args.get('next')) }}" novalidate>
      {{ form.csrf_token }}
      {{ field(form.email, 'you@example.com', 'fa-envelope', 'email') }}
      {{ field(form.password, 'Your password', 'fa-lock', 'current-password') }}
      {{ form.submit(class='btn btn-primary btn-block') }}
    </form>
    <p class="auth-foot">Need an account? <a href="{{ url_for('dashboard.registration') }}">Create one</a></p>
  </div>
</section>
{% endblock %}
