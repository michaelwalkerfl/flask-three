{% extends "base.jinja2" %}
{% from "_macros.jinja2" import field %}

{% block title %}Create account | {{ config.APP_NAME }}{% endblock %}

{% block content %}
<section class="auth">
  <div class="auth-card card">
    <div class="auth-head">
      <h1>Create your account</h1>
      <p class="muted">Get started in less than a minute.</p>
    </div>
    <form method="POST" action="{{ url_for('dashboard.registration') }}" novalidate>
      {{ form.csrf_token }}
      <div class="field-row">
        {{ field(form.first_name, 'Jane', autocomplete='given-name') }}
        {{ field(form.last_name, 'Doe', autocomplete='family-name') }}
      </div>
      {{ field(form.email, 'you@example.com', 'fa-envelope', 'email') }}
      {{ field(form.password, 'At least 8 characters', 'fa-lock', 'new-password') }}
      {{ field(form.password_confirm, 'Repeat your password', 'fa-lock', 'new-password') }}
      {{ form.submit(class='btn btn-primary btn-block') }}
    </form>
    <p class="auth-foot">Already have an account? <a href="{{ url_for('dashboard.signin') }}">Sign in</a></p>
  </div>
</section>
{% endblock %}
